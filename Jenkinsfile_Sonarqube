pipeline {
    agent any

    environment {
        // Define the SonarScanner and required paths
        SONAR_SCANNER_HOME = tool 'SonarQube Scanner'
        JAVA_HOME = tool 'Java_jdk_21'
        PATH = "${JAVA_HOME}/bin;${env.PATH}"
    }

    stages {
        // Checkout source code from the GitHub repository
        stage('Build') {
            steps {
                git branch: 'CI/CD', credentialsId: 'a79ed2e2-b2da-4422-9f8d-5c2febe66268', url: 'https://github.com/Sivada12/petclinic.git'
            }
        }

        // Run the Maven test cases
        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }

        // Archive JUnit test results
        stage('Result') {
            steps {
                junit '**/*.xml'
            }
        }

        // Perform SonarQube analysis
        stage('SonarQube Analysis') {
            steps {
                echo 'Running SonarQube Analysis...'
                withSonarQubeEnv('SonarQube') {
                    bat """
                    ${SONAR_SCANNER_HOME}/bin/sonar-scanner.bat ^
                        -Dsonar.projectKey=PetClinic:SonarQube ^
                        -Dsonar.projectName="T9 Petclinic Sonarqube" ^
                        -Dsonar.projectVersion=1.0 ^
                        -Dsonar.sources=src ^
                        -Dsonar.java.binaries=target/classes ^
                        -Dsonar.language=java ^
                        -Dsonar.exclusions=**/*.java
                    """
                }
            }
        }

        // Archive the artifacts (e.g., JAR files)
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: '**/*.jar', followSymlinks: false
            }
        }

        // **Post stage artifacts** (handle JUnit files explicitly if needed)
        stage('Post Actions') {
            steps {
                echo 'Pipeline finished. Archiving additional outputs if necessary.'
                step([$class: 'JUnitResultArchiver', testResults: '**/target/surefire-reports/*.xml'])
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed!'
        }
        failure {
            echo 'Pipeline failed!'
        }
        unstable {
            echo 'Pipeline marked as UNSTABLE due to test failures or SonarQube quality gates.'
        }
        success {
            echo 'Pipeline executed successfully, checking SonarQube Quality Gate...'
            script {
                def qg = waitForQualityGate()
                if (qg.status != 'OK') {
                    error "Pipeline aborted due to SonarQube Quality Gate failure: ${qg.status}"
                } else {
                    echo "SonarQube Quality Gate status: ${qg.status}"
                }
            }
        }
    }
}
